{
  "name": "ducky-cms",
  "version": "1.0.0",
  "description": "A simple CMS",
  "type": "module",
  "scripts": {
    "build": "sh -c 'rm -rf dist && mkdir -p dist && rollup -c && rm -f dist/*.js && rm -rf dist/dist'",
    "dev": "sh -c 'trap \"pkill -f \\\"php -S localhost:5173\\\"\" EXIT; concurrently \"rollup -c -w\" \"php -S localhost:5173\"'"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "postcss-import": "^16.2.0",
    "rollup": "^4.62.4",
    "rollup-plugin-postcss": "^4.0.2"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}